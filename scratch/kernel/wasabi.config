# WasabiOS カーネル設定
# Ubuntu のカーネル設定 (ubuntu-6.17.0-41-generic.config) を土台に、これを上乗せする。
# 土台が Ubuntu と同じなので、snap / Docker / Wi-Fi / サウンドなど Ubuntu のアプリが前提にする機能はそのまま入る。

# --- 名前 ---
CONFIG_LOCALVERSION="-wasabi"
CONFIG_DEFAULT_HOSTNAME="wasabi"

# --- 起動ロゴ (ペンギンの代わりにわさび) ---
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
# 静かな起動でもすぐにグラフィック画面に切り替えてロゴを出す
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
# 起動直前のデバッグ表示 (input_data: ... など) を出さない
# CONFIG_X86_VERBOSE_BOOTUP is not set

# --- Ubuntu 専用の鍵は持っていないので外す (モジュールの署名鍵はビルド時に自動で作られる) ---
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# --- デバッグ情報は作らない (ビルド時間とディスクを大きく節約) ---
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set

# --- wasabi-init (最初の段階) が使うものはモジュールではなく本体に組み込む ---
# ディスク・USB・CD
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
# ファイルシステム
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_EFIVAR_FS=y
# キーボード (起動に失敗したときのレスキュー画面で使う)
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_APPLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_ATKBD=y

# --- ノートPC・デスクトップでは使わないドライバーを外す (ビルド時間の節約) ---
# Wi-Fi・サウンド・カメラ (UVC)・GPU・USB 機器・Bluetooth・仮想化 (KVM)・コンテナは残している
# CONFIG_STAGING is not set
# CONFIG_INFINIBAND is not set
# CONFIG_ISDN is not set
# CONFIG_CAN is not set
# CONFIG_HAMRADIO is not set
# CONFIG_ATM is not set
# CONFIG_IEEE802154 is not set
# CONFIG_FPGA is not set
# CONFIG_GREYBUS is not set
# CONFIG_COMEDI is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_PCI_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# サーバー向けの高速 LAN カード
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_NET_VENDOR_CHELSIO is not set
# CONFIG_NET_VENDOR_QLOGIC is not set
# CONFIG_NET_VENDOR_BROCADE is not set
# CONFIG_NET_VENDOR_CAVIUM is not set
# CONFIG_NET_VENDOR_HUAWEI is not set
# CONFIG_NET_VENDOR_NETRONOME is not set
# CONFIG_NET_VENDOR_SOLARFLARE is not set
# CONFIG_NET_VENDOR_PENSANDO is not set
# CONFIG_NET_VENDOR_FUNGIBLE is not set
# CONFIG_NET_VENDOR_EMULEX is not set
# CONFIG_NET_VENDOR_MICROSOFT is not set
# サーバー向けのストレージ装置 (RAID カードなど)
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_FUSION is not set
# CONFIG_TARGET_CORE is not set
