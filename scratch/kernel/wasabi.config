# WasabiOS カーネル設定 (x86_64_defconfig にこれを上乗せする)
# "=y" はカーネル本体に組み込む。モジュール (=m) は使わず、1ファイルで完結させる。

# --- 名前 ---
CONFIG_LOCALVERSION="-wasabi"
CONFIG_DEFAULT_HOSTNAME="wasabi"

# --- 起動に必要なもの ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# --- 画面 (起動ロゴを出すためのフレームバッファ) ---
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
# 静かな起動 (quiet) でもすぐにグラフィック画面に切り替えて、ロゴを出す
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
# 起動直前のデバッグ表示 (input_data: ... など) を出さない
# CONFIG_X86_VERBOSE_BOOTUP is not set
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# --- MacBook (2012年前後の Intel Mac) ---
# キーボード (fn キーなど) とトラックパッド
CONFIG_HID_APPLE=y
CONFIG_MOUSE_BCM5974=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_EVDEV=y
# 温度・ファンのセンサーとキーボードのバックライト
CONFIG_HWMON=y
CONFIG_SENSORS_APPLESMC=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
# 画面の明るさ
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_APPLE=y
# 有線 LAN (Broadcom) と SATA の SSD/HDD
CONFIG_TIGON3=y
CONFIG_SATA_AHCI=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_USB_STORAGE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
# バッテリー・AC アダプター
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_SBS=y

# --- 仮想マシン (QEMU) で試すため ---
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_E1000=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
